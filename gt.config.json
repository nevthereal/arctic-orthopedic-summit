{
  "$schema": "https://assets.gtx.dev/config-schema.json",
  "defaultLocale": "en",
  "locales": [
    "fi"
  ],
  "files": {
    "json": {
      "include": [
        "messages/[locale].json"
      ]
    },
    "md": {
      "include": [
        "src/content/[locale]/**/*.md"
      ]
    }
  },
  "options": {
    "saveLocal": true
  }
}
