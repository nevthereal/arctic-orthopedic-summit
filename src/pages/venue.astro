---
import BaseLayout from "../layouts/BaseLayout.astro";
import MarkdownContent from "../components/MarkdownContent.astro";
const locale = Astro.url.pathname.split("/")[1] === "fi" ? "fi" : "en";
const content = import.meta.glob<
  import("astro").MarkdownInstance<Record<string, string>>
>("../content/*/venue.md", { eager: true });
const { frontmatter } = content[`../content/${locale}/venue.md`];
---

<BaseLayout title={frontmatter.title} desc={frontmatter.description}>
  <main class="mx-8 md:mx-16">
    <div class="md:grid md:grid-cols-2 gap-8">
      <div>
        <MarkdownContent name="venue" class="prose" /><iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1506.9934144192425!2d24.80723607790104!3d67.8081066559591!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x45d24d5a87b3f0fd%3A0xd00dac320805b483!2sHullu%20Poro%20(Hotel%20Crazy%20Reindeer)!5e0!3m2!1sde!2sch!4v1727347059773!5m2!1sde!2sch"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full max-md:h-[300px] md:h-[500px] mt-4"></iframe>
      </div><MarkdownContent name="travel" class="prose max-md:mt-8" />
    </div>
  </main>
</BaseLayout>
