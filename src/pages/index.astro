---
import BaseLayout from "../layouts/BaseLayout.astro";
import MarkdownContent from "../components/MarkdownContent.astro";
const locale = Astro.url.pathname.split("/")[1] === "fi" ? "fi" : "en";
const content = import.meta.glob<
  import("astro").MarkdownInstance<Record<string, string>>
>("../content/*/home.md", { eager: true });
const { frontmatter } = content[`../content/${locale}/home.md`];
import { Image } from "astro:assets";
import Banner from "../assets/banner.jpg";
---

<BaseLayout title={frontmatter.title} desc={frontmatter.description}>
  <section class="grid md:grid-cols-2 p-8 pt-0 md:pt-8 pb-16">
    <Image src={Banner} alt="Arctic Orthopedic Summit" loading="eager" />
    <MarkdownContent
      name="home"
      class="md:mx-16 md:my-auto mt-16 prose prose-h1:text-3xl"
    />
  </section>
  <section class="grid gap-6 md:grid-cols-2 mx-8 prose max-w-none">
    {["review-1", "review-2"].map(name => (
      <div class="flex items-center gap-10">
        <i class="fa-solid fa-user-doctor fa-2xl text-sky-300"></i>
        <MarkdownContent {name} />
      </div>
    ))}
  </section>
</BaseLayout>
