---
import BaseLayout from "../layouts/BaseLayout.astro";
import MarkdownContent from "../components/MarkdownContent.astro";
const locale = Astro.url.pathname.split("/")[1] === "fi" ? "fi" : "en";
const labels = getMessages(locale);
const content = import.meta.glob<
  import("astro").MarkdownInstance<Record<string, string>>
>("../content/*/activities.md", { eager: true });
const { frontmatter } = content[`../content/${locale}/activities.md`];
import { Image } from "astro:assets";
import { getMessages } from "../lib/i18n";
const gallery = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("../assets/activities/*.jpg", {
    eager: true,
  }),
);
---

<BaseLayout title={frontmatter.title} desc={frontmatter.description}>
  <main class="mx-8 md:mx-16 mb-8">
    <MarkdownContent name="activities" class="prose" /><MarkdownContent
      name="gallery"
      class="prose mt-8"
    /><div class="md:columns-3 mt-8 space-y-4">
      {
        gallery.map((img) => (
          <Image
            loading="lazy"
            src={img.default}
            alt={labels.activity}
            quality="mid"
          />
        ))
      }
    </div>
  </main>
</BaseLayout>
