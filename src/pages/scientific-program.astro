---
import BaseLayout from "../layouts/BaseLayout.astro";
import MarkdownContent from "../components/MarkdownContent.astro";
const locale = Astro.url.pathname.split("/")[1] === "fi" ? "fi" : "en";
const content = import.meta.glob<
  import("astro").MarkdownInstance<Record<string, string>>
>("../content/*/scientific-program.md", { eager: true });
const { frontmatter } = content[`../content/${locale}/scientific-program.md`];
---

<BaseLayout title={frontmatter.title} desc={frontmatter.description}>
  <main class="mx-8 md:mx-auto mb-8 max-w-6xl overflow-x-auto">
    <MarkdownContent
      name="scientific-program"
      class="prose max-w-none program"
    />
  </main>
</BaseLayout>
