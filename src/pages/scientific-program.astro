---
import { m } from "../paraglide/messages.js";
const locale = Astro.url.pathname.split("/")[1] === "fi" ? "fi" : "en";

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={m.scientific_program({}, { locale })}
  desc={m.the_scientific_program_of_the_arctic_orthopedic_summit(
    {},
    { locale },
  )}
>
  <main class="mx-8 mb-8">
    <h1 class="text-3xl mb-8">{m.scientific_program({}, { locale })}</h1>
    <p class="mb-4">
      {m.here_is_a_broad_overview_of_the_program({}, { locale })}
    </p>
    <a href="/program.pdf"
      ><button class="mb-4"> {m.full_program({}, { locale })} </button></a
    >

    <div class="max-md:overflow-auto">
      <p
        class="hidden max-md:portrait:block text-center font-bold mt-4 text-red-400"
      >
        {m.please_rotate_your_phone_to_landscape_mode_to({}, { locale })}
      </p>
      <table
        class="table-auto text-sm text-left border-collapse max-md:portrait:hidden"
      >
        <thead>
          <tr class="bg-gray-200">
            <th class="px-4 py-2 border"> {m.time({}, { locale })} </th>
            <th class="px-4 py-2 border">
              {m.sun_16_3_2025({}, { locale })}
            </th>
            <th class="px-4 py-2 border">
              {m.mon_17_3_2025({}, { locale })}
            </th>
            <th class="px-4 py-2 border">
              {m.tue_18_3_2025({}, { locale })}
            </th>
            <th class="px-4 py-2 border">
              {m.wed_19_3_2025({}, { locale })}
            </th>
            <th class="px-4 py-2 border">
              {m.thu_20_3_2025({}, { locale })}
            </th>
            <th class="px-4 py-2 border">
              {m.fri_21_3_2025({}, { locale })}
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="px-4 py-2 border">07:30-08:00</td>
            <td class="px-4 py-2 border"></td>
            <td class="px-4 py-2 border italic bg-blue-200">
              {m.registration({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-blue-200">
              {m.registration({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-blue-200">
              {m.registration({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-blue-200">
              {m.registration({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-blue-200">
              {m.registration({}, { locale })}
            </td>
          </tr>

          <tr>
            <td class="px-4 py-2 border">08:00-11:00</td>
            <td class="px-4 py-2 border"></td>
            <td class="px-4 py-2 border bg-red-200">
              <p class="font-bold">{m.traumatology_1({}, { locale })}</p>
              <p class="font-normal">
                {m.polytrauma_patient_anything_new({}, { locale })}
              </p>
              <p class="font-semibold">{m.tim_s_derlund({}, { locale })}</p>
            </td>
            <td class="px-4 py-2 border bg-red-200">
              <p class="font-bold">{m.traumatology_3({}, { locale })}</p>
              <p class="font-normal">
                {m.fix_it_or_fuse_it_controversies_in_foot({}, { locale })}
              </p>
              <p class="font-semibold">{m.anssi_h_rk_nen({}, { locale })}</p>
            </td>
            <td class="px-4 py-2 border bg-green-200">
              <p class="font-bold">{m.orthopedics_1({}, { locale })}</p>
              <p class="font-normal">
                {m.what_s_new_in_hip_replacement({}, { locale })}
              </p>
              <p class="font-semibold">{m.rami_madanat({}, { locale })}</p>
            </td>
            <td class="px-4 py-2 border bg-green-200">
              <p class="font-bold">{m.orthopedics_2({}, { locale })}</p>
              <p class="font-normal">
                {
                  m.decompression_of_degenerative_lumbar_spine_spondylodesis(
                    {},
                    { locale },
                  )
                }
              </p>
              <p class="font-semibold">{m.jari_siironen({}, { locale })}</p>
            </td>
            <td class="px-4 py-2 border bg-green-200">
              <p class="font-bold">{m.orthopedics_3({}, { locale })}</p>
              <p class="font-normal">
                {m.optimized_use_of_radiation_in_orthopedics({}, { locale })}
              </p>
              <p class="font-semibold">{m.liisa_viita_aho({}, { locale })}</p>
            </td>
          </tr>

          <tr>
            <td class="px-4 py-2 border">11:15-12:30</td>
            <td></td>
            <td class="px-4 py-2 border italic bg-yellow-200">
              {m.lunch({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-yellow-200">
              {m.lunch({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-yellow-200">
              {m.lunch({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-yellow-200">
              {m.lunch({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-yellow-200">
              {m.lunch({}, { locale })}
            </td>
          </tr>

          <tr>
            <td class="px-4 py-2 border">12:30-14:30</td>
            <td class="px-4 py-2 border"></td>
            <td class="px-4 py-2 border italic bg-gray-200">
              {m.industrial_meetings({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-gray-200">
              {m.industrial_meetings({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-gray-200">
              {m.industrial_meetings({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-gray-200">
              {m.industrial_meetings({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-gray-200 text-center">
              {m.end_discussion_and_adjourn_11_15_11_45({}, { locale })}
            </td>
          </tr>

          <tr>
            <td class="px-4 py-2 border">15:00-18:00</td>
            <td class="px-4 py-2 border italic bg-blue-200">
              {m.registration({}, { locale })}
            </td>
            <td class="px-4 py-2 border bg-red-200">
              <p class="font-bold">{m.traumatology_2({}, { locale })}</p>
              <p class="font-normal">
                {
                  m.primary_arthroplasty_in_shoulder_elbow_and_knee_trauma(
                    {},
                    { locale },
                  )
                }
              </p>
              <p class="font-semibold">{m.mikko_salmela({}, { locale })}</p>
            </td>
            <td class="px-4 py-2 border bg-pink-200">
              <p class="font-bold">{m.discussion_1({}, { locale })}</p>
              <p class="font-normal">
                {m.feedback_from_assessment_to_learning({}, { locale })}
              </p>
              <p class="font-semibold">
                {m.teija_lund_juho_hatakka({}, { locale })}
              </p>
              <p class="font-bold mt-4">{m.discussion_2({}, { locale })}</p>
              <p class="font-normal">
                {m.how_to_use_the_kids_fracture_tool_in({}, { locale })}
              </p>
              <p class="font-semibold">
                {m.topi_laaksonen_kaj_zilliacus({}, { locale })}
              </p>
            </td>
            <td></td>
            <td class="px-4 py-2 border bg-pink-200">
              <p class="font-bold">{m.discussion_3({}, { locale })}</p>
              <p class="font-normal">
                {m.pf_oa_pf_arthroplasty({}, { locale })}
              </p>
              <p class="font-semibold">{m.petri_silanp({}, { locale })}</p>
              <p class="font-bold mt-4">{m.discussion_4({}, { locale })}</p>
              <p class="font-normal">
                {m.controversies_in_bone_tumors({}, { locale })}
              </p>
              <p class="font-semibold">
                {m.minna_laitinen_lee_jays({}, { locale })}
              </p>
            </td>
            <td></td>
          </tr>
          <tr>
            <td class="px-4 py-2 border">18:00-19:00</td>
            <td class="px-4 py-2 border italic bg-gray-200">
              {m.opening_ceremony({}, { locale })}
            </td>
            <td></td>
            <td class="px-4 py-2 border italic bg-gray-200">
              {m.get_together({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-gray-200">
              {m.course_dinner({}, { locale })}
            </td>
            <td class="px-4 py-2 border italic bg-gray-200">
              {m.get_together_message({}, { locale })}
            </td>
            <td></td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>
</BaseLayout>
