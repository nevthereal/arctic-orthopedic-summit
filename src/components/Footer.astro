---
import { getMessages } from "../lib/i18n";
const locale = Astro.url.pathname.split("/")[1] === "fi" ? "fi" : "en";
const labels = getMessages(locale);

const committee = [
  { name: "Mikko Hautamäki", role: labels.chair },
  { name: "Timo Sirola", role: labels.secretary },
  { name: "Robert Björkenheim", role: labels.scientific_program },
  { name: "Jani Puhakka", role: labels.affiliation },
  { name: "Henrik Sandelin", role: labels.treasurer },
  { name: "Heidi Danielson", role: labels.member },
];
---

<footer
  class="max-w-[90%] flex flex-col-reverse md:flex-row md:justify-evenly max-md:gap-6 mx-auto py-4 mt-16 font-bold"
>
  <div class="flex justify-center flex-col items-center gap-2">
    <p>
      <a href="https://www.soy.fi/" target="_blank">
        {labels.finnish_orthopaedic_association}
      </a>
    </p>
    <p>
      {labels.contact}{" "}
      <a href="mailto:aos2025@soy.fi"> {labels.aos2025_soy_fi} </a>
    </p>
  </div>
  <div class="flex justify-center flex-col items-center gap-4">
    <h1 class="text-lg">{labels.organisation_committee}</h1>
    <ul class="text-xs text-center">
      {
        committee.map((member) => {
          return (
            <li>
              <p>
                {member.name} - <span class="font-normal">{member.role}</span>
              </p>
            </li>
          );
        })
      }
    </ul>
  </div>
</footer>
