---
import { m } from "../paraglide/messages.js";
const locale = Astro.url.pathname.split("/")[1] === "fi" ? "fi" : "en";

const committee = [
  { name: "Mikko Hautamäki", role: m.chair({}, { locale }) },
  { name: "Timo Sirola", role: m.secretary({}, { locale }) },
  { name: "Robert Björkenheim", role: m.scientific_program({}, { locale }) },
  { name: "Jani Puhakka", role: m.affiliation({}, { locale }) },
  { name: "Henrik Sandelin", role: m.treasurer({}, { locale }) },
  { name: "Heidi Danielson", role: m.member({}, { locale }) },
];
---

<footer
  class="max-w-[90%] flex flex-col-reverse md:flex-row md:justify-evenly max-md:gap-6 mx-auto py-4 mt-16 font-bold"
>
  <div class="flex justify-center flex-col items-center gap-2">
    <p>
      <a href="https://www.soy.fi/" target="_blank">
        {m.finnish_orthopaedic_association({}, { locale })}
      </a>
    </p>
    <p>
      {m.contact({}, { locale })}{" "}
      <a href="mailto:aos2025@soy.fi"> {m.aos2025_soy_fi({}, { locale })} </a>
    </p>
  </div>
  <div class="flex justify-center flex-col items-center gap-4">
    <h1 class="text-lg">{m.organisation_committee({}, { locale })}</h1>
    <ul class="text-xs text-center">
      {
        committee.map((member) => {
          return (
            <li>
              <p>
                {member.name} - <span class="font-normal">{member.role}</span>
              </p>
            </li>
          );
        })
      }
    </ul>
  </div>
</footer>
